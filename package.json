{
  "name": "nexo-proveedores",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4173",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test": "vitest run",
    "dev:api": "npm run dev --workspace @nexo/api",
    "dev:worker": "node --env-file=.env --import tsx scripts/procesador-local.ts",
    "dev:completo": "concurrently -k -n WEB,API,FUNCION \"npm run dev\" \"npm run dev:api\" \"npm run dev:worker\"",
    "emulador": "azurite --silent --location .azurite --skipApiVersionCheck --disableTelemetry",
    "configurar:local": "node scripts/configurar-local.mjs",
    "build:todo": "npm run build && npm run build --workspace @nexo/api && npm run build --workspace @nexo/functions",
    "test:integracion": "node scripts/probar-integracion.mjs",
    "paquete:api": "node scripts/preparar-paquete.mjs api",
    "paquete:functions": "node scripts/preparar-paquete.mjs functions"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^6.1.2",
    "azurite": "3.37.0",
    "concurrently": "^9.2.0",
    "prettier": "^3.9.10",
    "supertest": "^7.1.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "workspaces": [
    "api",
    "functions"
  ],
  "overrides": {
    "azurite": {
      "uuid": "11.1.1"
    }
  }
}
