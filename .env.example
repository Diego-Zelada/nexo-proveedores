# Este archivo es una plantilla. Crear .env con npm run configurar:local.
# Nunca usar prefijo VITE_ para contraseñas, tokens JWT o claves de Azure.
AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
AUTH_USERS_JSON=[]
AUTH_JWT_SECRET=
MAX_FILE_MB=10
SAS_SECONDS=60
ALLOWED_ORIGINS=http://localhost:4173,http://127.0.0.1:4173
PORT=3001
# En Azure se omite la conexión anterior y se usa identidad administrada:
# AZURE_STORAGE_ACCOUNT_NAME=nombredecuenta
# Para el frontend en otra dirección, solo esta URL pública es VITE_:
# VITE_API_URL=https://nombre-api.azurewebsites.net
